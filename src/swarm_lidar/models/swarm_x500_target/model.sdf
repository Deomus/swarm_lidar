<?xml version="1.0"?>
<sdf version="1.9">
  <model name="swarm_x500_target">
    <include merge="true"><uri>model://x500</uri></include>
    <link name="lidar_target_link">
      <pose relative_to="base_link">0 0 0.45 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>0.00025</ixx><iyy>0.00025</iyy><izz>0.00025</izz></inertia>
      </inertial>
      <collision name="target_collision"><geometry><sphere><radius>0.25</radius></sphere></geometry></collision>
      <visual name="target_visual">
        <geometry><sphere><radius>0.25</radius></sphere></geometry>
        <material><ambient>0.9 0.45 0.05 1</ambient><diffuse>0.9 0.45 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="target_joint" type="fixed"><parent>base_link</parent><child>lidar_target_link</child></joint>
  </model>
</sdf>
