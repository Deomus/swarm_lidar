<?xml version="1.0"?>
<sdf version="1.9">
  <model name="swarm_x500_leader">
    <include merge="true"><uri>model://x500</uri></include>
    <link name="lidar_link">
      <pose relative_to="base_link">0 0 1.9 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
      </inertial>
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>uav_0/lidar_link</gz_frame_id>
        <topic>/uav_0/lidar/scan</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1024</samples><resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>256</samples><resolution>1</resolution>
              <min_angle>-0.523598775598299</min_angle><max_angle>0.523598775598299</max_angle>
            </vertical>
          </scan>
          <range><min>0.15</min><max>80</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
  </model>
</sdf>
