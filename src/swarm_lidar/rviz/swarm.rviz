Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Сетка 1 м
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 120
    Reference Frame: map
    Color: 90; 100; 110
    Alpha: 0.3
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Карта /map (A*)
    Enabled: true
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Alpha: 0.6
    Color Scheme: map
    Draw Behind: true
    Value: true
  - Class: rviz_default_plugins/TF
    Name: TF map → base_link → lidar_link
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 2
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Облако LiDAR ведущего
    Enabled: true
    Topic:
      Value: /uav_0/lidar/points
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Filter size: 10
    Style: Points
    Size (Pixels): 3
    Color Transformer: AxisColor
    Axis: Z
    Decay Time: 0
    Value: true
  - Class: rviz_default_plugins/Path
    Name: Маршрут A*
    Enabled: true
    Topic:
      Value: /mission/path
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Color: 246; 197; 107
    Line Style: Billboards
    Line Width: 0.15
    Value: true
  - Class: rviz_default_plugins/Pose
    Name: Точка маршрута ведущего
    Enabled: true
    Topic:
      Value: /uav_0/setpoint/pose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Shape: Axes
    Axes Length: 1.2
    Axes Radius: 0.08
    Color: 255; 138; 115
    Value: true
  - Class: rviz_default_plugins/Pose
    Name: Место ведомого 1
    Enabled: true
    Topic:
      Value: /uav_1/setpoint/pose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Shape: Axes
    Axes Length: 1.2
    Axes Radius: 0.08
    Color: 201; 219; 230
    Value: true
  - Class: rviz_default_plugins/Pose
    Name: Место ведомого 2
    Enabled: true
    Topic:
      Value: /uav_2/setpoint/pose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Shape: Axes
    Axes Length: 1.2
    Axes Radius: 0.08
    Color: 201; 219; 230
    Value: true
  - Class: rviz_default_plugins/Pose
    Name: Место ведомого 3
    Enabled: true
    Topic:
      Value: /uav_3/setpoint/pose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Shape: Axes
    Axes Length: 1.2
    Axes Radius: 0.08
    Color: 201; 219; 230
    Value: true
  Enabled: true
  Global Options:
    Background Color: 16; 21; 27
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 45
      Focal Point:
        X: 5
        Y: 0
        Z: 0
      Pitch: 0.75
      Yaw: 3.6
      Target Frame: <Fixed Frame>
      Name: Current View
      Value: Orbit (rviz)
    Saved: null
Window Geometry:
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Displays:
    collapsed: false
